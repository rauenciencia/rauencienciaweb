# URL pública del sitio. Se usa para el sitemap, los metadatos y las tarjetas
# que se ven al compartir en WhatsApp, X o LinkedIn. Sin barra al final.
NEXT_PUBLIC_URL_SITIO=https://rauenciencia.com

# URL de la plataforma Becas para Migajear.
# Si el sitio personal se queda en la raíz del dominio y la plataforma se
# mueve a una ruta, aquí va "/becas". Si la plataforma se queda donde está
# hoy y el sitio personal vive en un subdominio, aquí va la URL completa.
NEXT_PUBLIC_URL_PLATAFORMA=https://rauenciencia.com
